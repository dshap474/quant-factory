{
  "name": "viz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "check:bundle": "node --test scripts/check-route-closures.test.mjs && node scripts/check-bundle.mjs && node scripts/check-route-closures.mjs",
    "check:ui": "node --test scripts/check-design-system.test.mjs && node scripts/check-qf-ui-boundaries.mjs && node scripts/check-design-system.mjs",
    "measure:app": "node scripts/measure-app.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0 && (test ! -d ../extensions || (cd ../extensions && ../web/node_modules/.bin/eslint . --max-warnings 0)) && biome check . && (test ! -d ../extensions || (cd ../extensions && ../web/node_modules/.bin/biome check --vcs-enabled=false --config-path=../web/biome.json .))",
    "lint:qf-ui": "pnpm -C ../qf-ui run lint",
    "typecheck:qf-ui": "pnpm -C ../qf-ui run typecheck",
    "test:qf-ui": "pnpm -C ../qf-ui run test",
    "format": "biome check --write .",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.ts",
    "gate:fast": "pnpm run check:api && pnpm run lint && pnpm run check:ui && pnpm run typecheck && pnpm run test && pnpm run lint:qf-ui && pnpm run typecheck:qf-ui && pnpm run test:qf-ui",
    "gate:full": "pnpm run check:api && pnpm run lint && pnpm run check:ui && pnpm run typecheck && pnpm run test && pnpm run lint:qf-ui && pnpm run typecheck:qf-ui && pnpm run test:qf-ui && pnpm run build && pnpm run check:bundle && PLAYWRIGHT_SKIP_BUILD=1 pnpm run test:e2e && PLAYWRIGHT_SKIP_BUILD=1 pnpm run test:e2e:integration"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@quant-factory/qf-ui": "workspace:*",
    "@radix-ui/react-select": "2.3.6",
    "@tanstack/react-query": "5.101.2",
    "dompurify": "3.2.7",
    "katex": "0.19.1",
    "lucide-react": "0.454.0",
    "marked": "16.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
